{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIStack source index v1",
  "type": "object",
  "required": ["meta", "nodes", "edges", "unresolved", "skipped"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["target", "source_revision", "created_at", "indexer_version", "processed_files", "duration_ms"],
      "properties": {
        "target": {"type": "string"},
        "source_revision": {"type": ["string", "null"]},
        "source_dirty": {"type": ["boolean", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "indexer_version": {"const": "0.1.0"},
        "processed_files": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "number", "minimum": 0},
        "source_files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
      }
    },
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "skipped": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
  },
  "$defs": {
    "location": {
      "type": "object", "required": ["file", "line"],
      "properties": {"file": {"type": "string"}, "line": {"type": "integer", "minimum": 1}}
    },
    "node": {
      "type": "object", "required": ["id", "kind", "name", "file", "line"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"},
        "kind": {"enum": ["jsp", "js", "endpoint", "class", "method", "sql", "fragment", "resultMap", "table", "view", "procedure", "config", "unknown"]},
        "file": {"type": "string"}, "line": {"type": "integer", "minimum": 1},
        "details": {"type": "object"}
      }
    },
    "edge": {
      "type": "object", "required": ["from", "to", "kind", "status", "evidence"],
      "properties": {
        "from": {"type": "string"}, "to": {"type": "string"},
        "kind": {"enum": ["calls", "requests", "maps_to", "intercepted_by", "executes", "includes", "reads", "writes"]},
        "status": {"enum": ["CONFIRMED", "LIKELY", "UNRESOLVED"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/location"}},
        "reason": {"type": "string", "minLength": 1},
        "evidence_truncated": {"type": "boolean"},
        "candidates": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{"if": {"properties": {"status": {"enum": ["LIKELY", "UNRESOLVED"]}}}, "then": {"required": ["reason"]}}]
    },
    "issue": {
      "type": "object", "required": ["file", "line", "pattern", "reason"],
      "properties": {
        "file": {"type": "string"}, "line": {"type": "integer", "minimum": 1},
        "pattern": {"type": "string"}, "reason": {"type": "string"}, "from": {"type": "string"},
        "constants": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_revision",
    "source_files",
    "rows",
    "unverified"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "kind": {
      "const": "program-list"
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "values",
          "evidence",
          "unverified",
          "status",
          "reason"
        ],
        "properties": {
          "values": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "program_id",
              "program_name",
              "url",
              "http_method",
              "screen",
              "controller",
              "service",
              "mapper"
            ],
            "properties": {
              "program_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "program_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "http_method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "screen": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "controller": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "service": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mapper": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "program_type": {
                "enum": [
                  "화면",
                  "클래스",
                  "SQL",
                  null
                ]
              },
              "related_sources": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "line"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "unverified": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "LIKELY",
              "UNRESOLVED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "not_applicable": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "field_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "status",
                "file",
                "line",
                "reason"
              ],
              "properties": {
                "field": {
                  "const": "program_name"
                },
                "status": {
                  "const": "LIKELY"
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}

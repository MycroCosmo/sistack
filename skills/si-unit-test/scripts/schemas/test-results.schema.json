{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sistack.local/schemas/test-results.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "source_revision", "status", "execution_status", "environment", "summary", "tests", "unverified"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_revision": { "type": ["string", "null"], "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED"] },
    "execution_status": { "enum": ["SUCCESS", "TEST_FAILURE", "BUILD_FAILURE", "BLOCKED"] },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["java_runtime", "java_target", "build_tool", "junit", "mockito", "spring_test", "h2"],
      "properties": {
        "java_runtime": { "type": "string", "minLength": 1 }, "java_target": { "type": "string", "minLength": 1 },
        "build_tool": { "type": "string", "minLength": 1 }, "junit": { "type": "string", "minLength": 1 },
        "mockito": { "type": "string", "minLength": 1 }, "spring_test": { "type": "string", "minLength": 1 },
        "h2": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "failed", "errors", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 }, "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }, "errors": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "tests": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["class_name", "method_name", "display_name", "target_class", "target_method", "status", "duration_ms", "failure_message", "report_file"],
        "properties": {
          "class_name": { "type": "string", "minLength": 1 }, "method_name": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "pattern": "[가-힣]" },
          "target_class": { "type": "string", "minLength": 1 }, "target_method": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "ERROR", "SKIP"] }, "duration_ms": { "type": "integer", "minimum": 0 },
          "failure_message": { "type": "string" }, "report_file": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unverified": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
